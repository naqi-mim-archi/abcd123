GEMINI_API_KEY=
GOOGLE_VERTEX_SA_KEY_JSON=
GOOGLE_VERTEX_RENDER_SA_KEY_JSON=
VITE_GOOGLE_MAPS_PLATFORM_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Server-side ID-token verification for the /api auth gate. The project id is all that is
# needed — token signatures are checked against Google's public certs. Usually the same
# value as VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Optional: only needed if a route ever has to act with admin privileges. Verification
# alone does not require it.
FIREBASE_ADMIN_SA_KEY_JSON=
# Dev only. Set to 1 to let /api routes serve unauthenticated callers, so `vite dev` can be
# used without signing in. NEVER set this in production — with it on, anyone who knows the
# URL can spend the project's AI quota. (The scripts/test*.mjs harnesses call the services
# in-process and never go through these routes, so they do not need it.)
ALLOW_ANONYMOUS_API=
# --- Billing -----------------------------------------------------------------
# The token ledger lives in Firestore and is written with admin credentials, so
# FIREBASE_ADMIN_SA_KEY_JSON above is REQUIRED for billing (a project id alone is enough to
# verify a token, but not to read or write a document). Without it, every chargeable route
# answers 503 rather than quietly handing out paid AI work for free.
# Set to 1 to run the AI routes without charging tokens — local dev, or a demo. Production
# must never set it.
ALLOW_UNMETERED_API=
# Stripe. The webhook is what credits an account, so the secret matters as much as the key:
# point a Stripe endpoint at https://<your-domain>/api/stripe-webhook for
# `checkout.session.completed` and paste its signing secret here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe returns the buyer to. Falls back to the request origin, then VERCEL_URL.
APP_BASE_URL=
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_REGION=
APS_BUCKET_KEY=
APS_REVIT_ENGINE=
APS_REVIT_IMPORT_ENGINE=
APS_REVIT_IMPORT_APPBUNDLE_ID=
APS_REVIT_IMPORT_ACTIVITY_ID=
APS_REVIT_IMPORT_ACTIVITY_ALIAS=
APS_REVIT_APPBUNDLE_ID=
APS_REVIT_ACTIVITY_ID=
APS_REVIT_ACTIVITY_ALIAS=
APS_REVIT_ENGINE_2026=
APS_REVIT_APPBUNDLE_ID_2026=
APS_REVIT_ACTIVITY_ID_2026=
APS_REVIT_ACTIVITY_ALIAS_2026=
ROBOFLOW_WALL_API_KEY=
ROBOFLOW_WALL_WORKSPACE=
ROBOFLOW_WALL_WORKFLOW_ID=
ROBOFLOW_API_URL=
# STRUCTURED3D_URL removed — Text 4.0 J now calls Roboflow directly instead of a local service.
# Auto-populated once Vercel KV is attached to the project — do not set manually:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
